{
 "paper": "Roboflow100-VL: A Multi-Domain Object Detection Benchmark for Vision-Language Models",
 "arxiv": "2505.20612v4",
 "source_note": "Rows parsed from the uncommented LaTeX table rows in src/neurips_2025.tex and src/suppl.tex and checked against paper.pdf (v4). Commented-out rows in the LaTeX (older numbers) are excluded.",
 "metric": "AP per dataset (pycocotools, maxDets=500; Appendix H calls it 'mAP 50:95'), averaged over the datasets in each category; 'All' averages all datasets of the benchmark (Sec. 4.1, Sec. 3.2, App. B, App. H).",
 "eval_protocol": "Every method in every data regime is evaluated on the same fully annotated test split per dataset (Sec. 4.1). No per-dataset tuning of parameters or zero-shot prompts (Sec. 3.2). Few-shot splits: K=10 instances per class following Wang et al. 2020 (TFA) protocol, choosing among random candidate splits the one with the largest average box area (Fig. 4 caption, App. E). Semi-supervised split: random 10% of the train set (App. F).",
 "prompting_asymmetries": {
  "GroundingDINO": "MM-GroundingDINO-L* weights from mmdetection; all class names concatenated into one prompt; few-shot = full fine-tune 1000 iterations, batch 4, lr 3e-4, images resized to (640, 1333), no extra augmentation (App. A)",
  "OWLv2": "HuggingFace implementation; each class name prompted independently (App. A)",
  "Detic": "Swin-L, checkpoint trained on LVIS, COCO and ImageNet-21K; class names as CLIP classifier prompts (App. A); few-shot uses federated loss of Madan et al. (Sec. 3.2)",
  "MQ-GLIP": "GLIP Swin-L trained on Objects365, FourODs, GoldG, Cap24M; class names as text prompts and few-shot images as visual prompts; frozen (App. A, Sec. 3.2)",
  "Qwen 2.5 VL (72B)": "API; multi-class prompt in Table 2 (caption), single-class in Table 1 (caption); Table 3 does not say; at most 3 few-shot images; confidence set to 1.0 (App. A)",
  "Gemini 2.5 Pro": "gemini-2.5-pro-preview-03-25 via API; multi-class prompt in Table 2 (caption), single-class in Table 1 (caption); Table 3 does not say; all few-shot images; confidence set to 1.0 (App. A)",
  "YOLOv8/YOLOv11": "Ultralytics defaults, 100 epochs, batch 16, evaluated with pycocotools (App. A); few-shot federated variant uses per-image hard negatives instead of Madan et al. frequency prior (Sec. 3.2)"
 },
